#!/bin/sh
set -e
export LC_ALL=C

if [ -z "$1" ]; then
    echo "Aborting. Please provide a commit hash or a tag/branch name."
    exit 1
fi

# test-hls-8.0 branch: force FFmpeg n8.0 regardless of the argument
# passed by the workflow (which still says n7.1.5). Only the FFmpeg
# version changes; the rest of the official build chain is untouched.
scripts/switch-branch ffmpeg "@n8.0"
